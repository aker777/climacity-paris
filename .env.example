# Copier ce fichier en .env et l'adapter à la machine.
JUPYTER_PORT=8888
SPARK_UI_PORT=4040
MLFLOW_PORT=5000
JUPYTER_TOKEN=climacity

# Ressources : garder DOCKER_MEMORY_LIMIT >= 1,5 x SPARK_DRIVER_MEMORY
# et sous la mémoire allouée à Docker Desktop / WSL.
#   Docker 8 Go  -> 7g / 4g
#   Docker 16 Go -> 12g / 8g
DOCKER_MEMORY_LIMIT=7g
DOCKER_CPU_LIMIT=8
SPARK_DRIVER_MEMORY=4g
